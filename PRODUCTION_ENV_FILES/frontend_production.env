# Frontend Environment Configuration for Production
# Copy this file as .env in your frontend directory on live server

# API Configuration
NEXT_PUBLIC_API_BASE_URL=https://awantikaseeds.com
NEXT_PUBLIC_FRONTEND_URL=https://awantikaseeds.com

# NDPS Payment Gateway Configuration
NEXT_PUBLIC_NDPS_CDN_URL=https://psa.atomtech.in/staticdata/ots/js/atomcheckout.js

# Environment
NODE_ENV=production

# Other configuration (if needed)
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_SITE_NAME=Awantika Seeds